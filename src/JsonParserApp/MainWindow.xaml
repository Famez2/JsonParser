<Window x:Class="JsonParserApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JsonParserApp"
        mc:Ignorable="d"
        Title="JSON Parser" Height="450" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Для кнопок -->
            <RowDefinition Height="*"/>
            <!-- Для DataGrid -->
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10">
            <Button Content="Выбрать JSON"
                    Command="{Binding SelectJsonFileCommand}"
                    Height="30" Width="150"
                    Margin="0,0,10,0"/>

            <Button Content="Загрузить JSON"
                    Command="{Binding LoadJsonCommand}"
                    Height="30" Width="150"/>
        </StackPanel>

        <DataGrid x:Name="DataGridCompanies"
                  ItemsSource="{Binding Companies}"
                  AutoGenerateColumns="True"
                  Grid.Row="1"
                  Margin="10"/>
    </Grid>

</Window>
